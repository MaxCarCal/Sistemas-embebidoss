module uart_tx #(
    parameter CLK_FREQ  = 50000000,
    parameter BAUD_RATE = 9600
)(
    input  wire       clk,
    input  wire       reset,      // reset asincrono, activo en alto
    input  wire       tx_start,   // pulso para iniciar transmision
    input  wire [7:0] data_in,    // byte a transmitir
    output reg        tx,         // linea serial (reposo = 1)
    output reg        busy        // 1 mientras se transmite
);

// Ciclos de reloj por bit: 50,000,000 / 9600 = 5208
localparam integer CLKS_PER_BIT = CLK_FREQ / BAUD_RATE;

// Estados
localparam [1:0] S_IDLE  = 2'd0,
                 S_START = 2'd1,
                 S_DATA  = 2'd2,
                 S_STOP  = 2'd3;

reg [1:0]  state;
reg [15:0] clk_count;
reg [2:0]  bit_index;
reg [7:0]  data_reg;

always @(posedge clk or posedge reset) begin
    if (reset) begin
        state     <= S_IDLE;
        tx        <= 1'b1;
        busy      <= 1'b0;
        clk_count <= 16'd0;
        bit_index <= 3'd0;
        data_reg  <= 8'd0;
    end else begin
        case (state)

            // Linea en reposo, esperando tx_start
            S_IDLE: begin
                tx        <= 1'b1;
                busy      <= 1'b0;
                clk_count <= 16'd0;
                bit_index <= 3'd0;
                if (tx_start) begin
                    data_reg <= data_in;   // captura el dato
                    busy     <= 1'b1;
                    tx       <= 1'b0;      // inicia bit de start
                    state    <= S_START;
                end
            end

            // Bit de inicio (0) durante CLKS_PER_BIT ciclos
            S_START: begin
                if (clk_count == CLKS_PER_BIT - 1) begin
                    clk_count <= 16'd0;
                    bit_index <= 3'd0;
                    tx        <= data_reg[0];   // primer bit de datos (LSB)
                    state     <= S_DATA;
                end else begin
                    clk_count <= clk_count + 16'd1;
                end
            end

            // 8 bits de datos, LSB primero
            S_DATA: begin
                if (clk_count == CLKS_PER_BIT - 1) begin
                    clk_count <= 16'd0;
                    if (bit_index == 3'd7) begin
                        tx    <= 1'b1;          // bit de paro
                        state <= S_STOP;
                    end else begin
                        bit_index <= bit_index + 3'd1;
                        tx        <= data_reg[bit_index + 3'd1];
                    end
                end else begin
                    clk_count <= clk_count + 16'd1;
                end
            end

            // Bit de paro (1)
            S_STOP: begin
                if (clk_count == CLKS_PER_BIT - 1) begin
                    clk_count <= 16'd0;
                    busy      <= 1'b0;
                    state     <= S_IDLE;
                end else begin
                    clk_count <= clk_count + 16'd1;
                end
            end

            default: state <= S_IDLE;
        endcase
    end
end

endmodule
