 module uart_rx #(
    parameter CLK_FREQ  = 50000000,
    parameter BAUD_RATE = 9600
)(
    input  wire       clk,
    input  wire       reset,        // reset asincrono, activo en alto
    input  wire       rx,           // linea serial de entrada
    output reg  [7:0] data_out,     // byte recibido
    output reg        data_valid    // pulso de 1 ciclo: byte listo
);

localparam integer CLKS_PER_BIT = CLK_FREQ / BAUD_RATE;   // 5208
localparam integer HALF_BIT     = CLKS_PER_BIT / 2;       // 2604

// Estados
localparam [1:0] S_IDLE  = 2'd0,
                 S_START = 2'd1,
                 S_DATA  = 2'd2,
                 S_STOP  = 2'd3;

// ---------- Sincronizador de 2 flip-flops ----------
reg rx_sync1;
reg rx_sync2;

always @(posedge clk or posedge reset) begin
    if (reset) begin
        rx_sync1 <= 1'b1;
        rx_sync2 <= 1'b1;
    end else begin
        rx_sync1 <= rx;
        rx_sync2 <= rx_sync1;
    end
end

// ---------- Maquina de estados del receptor ----------
reg [1:0]  state;
reg [15:0] clk_count;
reg [2:0]  bit_index;
reg [7:0]  rx_shift;

always @(posedge clk or posedge reset) begin
    if (reset) begin
        state      <= S_IDLE;
        clk_count  <= 16'd0;
        bit_index  <= 3'd0;
        rx_shift   <= 8'd0;
        data_out   <= 8'd0;
        data_valid <= 1'b0;
    end else begin
        data_valid <= 1'b0;   // por defecto, el pulso dura 1 ciclo

        case (state)

            // Espera el flanco de bajada (bit de inicio)
            S_IDLE: begin
                clk_count <= 16'd0;
                bit_index <= 3'd0;
                if (rx_sync2 == 1'b0)
                    state <= S_START;
            end

            // Espera medio bit y confirma que el inicio sigue en 0
            // (descarta pulsos de ruido)
            S_START: begin
                if (clk_count == HALF_BIT - 1) begin
                    clk_count <= 16'd0;
                    if (rx_sync2 == 1'b0)
                        state <= S_DATA;    // inicio valido
                    else
                        state <= S_IDLE;    // falsa alarma
                end else begin
                    clk_count <= clk_count + 16'd1;
                end
            end

            // Muestrea cada bit de dato en su centro (LSB primero)
            S_DATA: begin
                if (clk_count == CLKS_PER_BIT - 1) begin
                    clk_count           <= 16'd0;
                    rx_shift[bit_index] <= rx_sync2;
                    if (bit_index == 3'd7) begin
                        bit_index <= 3'd0;
                        state     <= S_STOP;
                    end else begin
                        bit_index <= bit_index + 3'd1;
                    end
                end else begin
                    clk_count <= clk_count + 16'd1;
                end
            end

            // Verifica el bit de paro en su centro y publica el byte
            S_STOP: begin
                if (clk_count == CLKS_PER_BIT - 1) begin
                    clk_count <= 16'd0;
                    state     <= S_IDLE;
                    if (rx_sync2 == 1'b1) begin   // bit de paro correcto
                        data_out   <= rx_shift;
                        data_valid <= 1'b1;
                    end
                end else begin
                    clk_count <= clk_count + 16'd1;
                end
            end

            default: state <= S_IDLE;
        endcase
    end
end

endmodule
